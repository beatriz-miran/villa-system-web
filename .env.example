# Conexão com pool usada pelo aplicativo em execução.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-POOLER.neon.tech/BANCO?sslmode=require&channel_binding=require"

# Conexão direta usada pelo Prisma CLI e pelas migrations.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/BANCO?sslmode=require&channel_binding=require"

# Chave usada para assinar e proteger as sessões de autenticação.
AUTH_SECRET="substitua-por-uma-chave-secreta-forte"